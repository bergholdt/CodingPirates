# Kopiér til config/deploy.yml i UNDERVISERENS deploy-kopi af elevens Rails-app.
# Erstat alle EKSEMPLER før brug. Det er ikke en færdig serverkonfiguration.
service: pirat-hold01
image: DIT_REGISTRY_BRUGERNAVN/pirat-hold01
servers:
  web:
    - DIN_SERVERS_IP
registry:
  server: ghcr.io
  username: DIT_GITHUB_BRUGERNAVN
  password:
    - KAMAL_REGISTRY_PASSWORD
builder:
  arch: amd64
proxy:
  host: hold01.pirater.DIT_DOMAENE.dk
  app_port: 3000
  ssl: false
  forward_headers: true
  # Caddy/nginx på værten står for HTTPS. Samme run-opsætning for alle hold.
  run:
    http_port: 18090
    https_port: 18443
    bind_ips:
      - 127.0.0.1
  healthcheck:
    path: /up
ssh:
  user: DIN_DEPLOY_BRUGER
volumes:
  - pirat_hold01_data:/rails/storage
env:
  clear:
    APP_HOST: hold01.pirater.DIT_DOMAENE.dk
    COURSE_USER: hold01
    DATABASE_PATH: /rails/storage/production.sqlite3
  secret:
    - SECRET_KEY_BASE
    - COURSE_PASSWORD
